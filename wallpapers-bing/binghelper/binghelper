def cmd_list(args):
    args = list(args)
    consolidated = False
    for token in ("--consolidated", CONSOLIDATED_ID):
        while token in args:
            args.remove(token)
            consolidated = True
    if consolidated:
        rows = view_rows(preferred_market())
        if not rows:
            rows = [e + (is_pinned(e[2]),) for e in archive_entries(DEFAULT_MARKETS)]
    elif args and args[0] == "--all":
        rows = [e + (is_pinned(e[2]),) for e in archive_entries(all_archived_markets())]
    elif args:
        rows = [e + (is_pinned(e[2]),) for e in archive_entries([m for m in args if MARKET_RE.match(m)])]
    else:
        rows = [e + (is_pinned(e[2]),) for e in archive_entries(DEFAULT_MARKETS)]
    thumbs = thumbs_for([row[3] for row in rows])
    out = []
    for (date, market, image, meta, pinned), thumb in zip(rows, thumbs):
        out.append(
            {
                "provider": "bing",
                "date": date,
                "market": market,
                "path": str(image),
                "caption": meta.get("caption", ""),
                "copyright": meta.get("copyright", ""),
                "thumbnail_path": thumb,
                "pinned": pinned,
            }
        )
    print(json.dumps(out, ensure_ascii=False, indent=2))
    return 0


def cmd_pin(args, pinned):
    usage = f"usage: {APP_NAME} pin|unpin <market> <yyyymmdd>"
    if len(args) != 2 or not MARKET_RE.match(args[0]) or not DATE_RE.match(args[1]):
        print(usage, file=sys.stderr)
        return 2
    marker = DATA_ROOT / args[0] / f"{args[1]}.pinned"
    if not marker.with_suffix(".jpg").exists():
        print(f"no archived image: {marker.with_suffix('.jpg')}", file=sys.stderr)
        return 1
    if pinned:
        marker.write_text("pinned\n")
    else:
        marker.unlink(missing_ok=True)
    return 0


def cmd_markets(_args):
    print(f"{CONSOLIDATED_ID}\t{CONSOLIDATED_NAME}")
    for code, name in MARKET_NAMES:
        print(f"{code}\t{name}")
    return 0


def cmd_market(args):
    if not args:
        print(preferred_market() or "all")
        return 0
    value = args[0].strip()
    low = value.lower()
    if low in ("all", "consolidated", CONSOLIDATED_ID):
        value = "all"
    elif low == "auto":
        value = "auto"
    else:
        m = MARKET_RE.match(value)
        value = f"{m.group(1).lower()}-{m.group(2).upper()}" if m else None
        if value not in DEFAULT_MARKETS:
            print(f"market: unknown market {args[0]!r}", file=sys.stderr)
            return 2
    MARKET_FILE.parent.mkdir(parents=True, exist_ok=True)
    tmp = MARKET_FILE.with_name(MARKET_FILE.name + ".tmp")
    tmp.write_text(value + "\n")
    os.replace(tmp, MARKET_FILE)
    return 0


def cmd_consolidate(_args):
    with Lock(wait=120) as got:
        if not got:
            log("consolidate: lock busy")
            return 1
        return consolidate_locked(preferred_market())


def take_options(args):
    global PREFER, IF_STALE, PREFERRED_ONLY
    rest = []
    it = iter(args)
    for arg in it:
        if arg == "--prefer":
            PREFER = next(it, "")
        elif arg.startswith("--prefer="):
            PREFER = arg.split("=", 1)[1]
        elif arg == "--if-stale":
            IF_STALE = True
        elif arg == "--preferred-only":
            PREFERRED_ONLY = True
        else:
            rest.append(arg)
    return rest


if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help"):
    print(USAGE)
    raise SystemExit(0)
cmd = sys.argv[1] if len(sys.argv) > 1 else "fetch"
args = take_options(sys.argv[2:])
commands = {
    "fetch": cmd_fetch,
    "pick": cmd_pick,
    "latest": cmd_latest,
    "info": cmd_info,
    "list": cmd_list,
    "markets": cmd_markets,
    "market": cmd_market,
    "consolidate": cmd_consolidate,
}
if cmd == "pin":
    raise SystemExit(cmd_pin(args, True))
if cmd == "unpin":
    raise SystemExit(cmd_pin(args, False))
if cmd not in commands:
    print(USAGE, file=sys.stderr)
    raise SystemExit(2)
raise SystemExit(commands[cmd](args))
